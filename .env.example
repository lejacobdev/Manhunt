# Root .env consumed by docker-compose.yml — copy to .env and fill in real
# values before running `docker compose up -d --build`.

POSTGRES_USER=hunting_game
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=hunting_game

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret

# The backend container's port, bound to 127.0.0.1 only (never exposed
# publicly) — Apache reverse-proxies api.lejacob.dev to this port over
# loopback. Must match the port used in deploy/apache/api.lejacob.dev.conf.
BACKEND_PORT=8420

# Lock this to your app's real origin once you're past testing.
CORS_ORIGIN=*

# Moderation alerts: an email to REPORT_ALERT_TO for every new player report. Leave SMTP_HOST
# empty to switch alerts off; reports are still saved and shown in the admin panel either way.
SMTP_HOST=mail.lejacob.dev
SMTP_PORT=587
SMTP_USER=contact@lejacob.dev
SMTP_PASS=change-me
REPORT_ALERT_TO=contact@lejacob.dev
ADMIN_URL=https://lejacob.dev/admin/

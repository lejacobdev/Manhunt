# Root .env consumed by docker-compose.yml — copy to .env and fill in real
# values before running `docker compose up -d --build`.

POSTGRES_USER=hunting_game
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=hunting_game

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret

# The domain Caddy requests a TLS cert for and listens on. Must already have
# a DNS A record pointing at this server. If you don't own a domain, sslip.io
# gives you a free one that resolves straight to your server's IP: replace
# the dots in your IP with dashes and append ".sslip.io"
# (e.g. 31.214.141.29 -> 31-214-141-29.sslip.io).
DOMAIN=lejacob.eu

# Lock this to your app's real origin once you're past testing.
CORS_ORIGIN=*

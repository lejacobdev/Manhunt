datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlayerRole {
  HUNTER
  RUNNER
  SPECTATOR
}

enum GameStatus {
  LOBBY
  ACTIVE
  PAUSED
  ENDED
}

enum GameMode {
  STANDARD
  INFECTION
  SQUAD
}

enum PowerUpType {
  INVISIBILITY_10MIN
  GHOST_DECOY
  EMP_JAMMER
  THERMAL_VISION
  ADRENALINE
  SAFE_ZONE_FLARE
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

/// What a report is actually about. Structured rather than free text so reports can be
/// triaged and counted by kind — "3 cheating reports against this account this week" is
/// actionable in a way that three paragraphs of prose isn't.
/// Where a report is in the moderation queue.
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportCategory {
  CHEATING
  INAPPROPRIATE_USERNAME
  HARASSMENT
  THREATS
  SEXUAL_CONTENT
  IMPERSONATION
  UNSAFE_PLAY
  OTHER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(uuid())
  username     String
  userTag      String
  passwordHash String
  avatarUrl    String?
  /// Grants access to the admin panel. Checked against the database on every admin
  /// request rather than read from the JWT, so revoking it takes effect immediately
  /// instead of whenever that user's month-long token happens to expire.
  isAdmin      Boolean  @default(false)
  /// A banned account can't sign in and can't open a game socket. Existing REST tokens
  /// keep working until they expire — gameplay is the thing worth cutting off, and that
  /// all runs over the socket.
  isBanned     Boolean  @default(false)
  bannedAt     DateTime?
  banReason    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentRequests Friendship[]  @relation("SentRequests")
  recvRequests Friendship[]  @relation("RecvRequests")
  players      GamePlayer[]
  sentInvites  GameInvite[]  @relation("SentInvites")
  recvInvites  GameInvite[]  @relation("RecvInvites")
  deviceTokens DeviceToken[]

  @@unique([username, userTag])
  @@index([username])
}

// One row per device this account has granted push permission on — a user can have
// several (phone + a reinstall's new token, etc.), so pushes fan out to every row.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Friendship {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id])
  receiver User @relation("RecvRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

// A user-filed report of another user (App Store guideline 1.2 requires apps with
// user-generated content to let people flag objectionable content/behavior). No
// `@relation` back to User on either side deliberately — a reported account can later be
// deleted (see the account-deletion route) without that cascading into report rows or
// blocking it via a foreign key; the report itself should outlive the account it was
// filed against.
model Report {
  id             String         @id @default(uuid())
  reporterId     String
  reportedUserId String
  category       ReportCategory @default(OTHER)
  status         ReportStatus   @default(OPEN)
  /// What we wrote back to the reporter. Delivered as a push notification and kept here
  /// so the conversation survives the notification being swiped away.
  adminResponse  String?
  respondedAt    DateTime?
  /// The admin's user id. Not a relation, for the same reason the reporter isn't — an
  /// admin account being deleted shouldn't take the moderation history with it.
  handledBy      String?
  /// Optional free-text detail on top of the category — required only for OTHER, where the
  /// category alone says nothing. Reports filed before categories existed kept their prose
  /// here and were backfilled to OTHER.
  reason         String?
  createdAt      DateTime       @default(now())

  @@index([reportedUserId])
  @@index([category])
  @@index([status])
}

/// Every consequential thing an admin does, kept permanently. Moderation without a record
/// of who did what is just unaccountable power over other people's accounts — and when
/// something is disputed later, "which admin banned this person, when, and why" needs an
/// answer. Not relations, so deleting either the admin or the target leaves the trail.
/// Admin-managed additions to the built-in username filter. `isAllowlist` entries are the
/// opposite: innocent words that contain a blocked term and should be let through.
model BlockedTerm {
  id          String   @id @default(uuid())
  term        String   @unique
  category    String   @default("CUSTOM")
  isAllowlist Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

model GameSession {
  id        String     @id @default(uuid())
  code      String     @unique
  status    GameStatus @default(LOBBY)
  mode      GameMode   @default(STANDARD)
  hostId    String
  settings  Json
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime   @default(now())

  players  GamePlayer[]
  powerUps PowerUpSpawn[]
  events   GameEvent[]
  logs     LocationLog[]
  invites  GameInvite[]

  @@index([code])
  @@index([status])
}

// A friend-to-lobby invite for a specific game session — durable so it survives the recipient being offline.
model GameInvite {
  id          String       @id @default(uuid())
  sessionId   String
  fromUserId  String
  toUserId    String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  session  GameSession @relation(fields: [sessionId], references: [id])
  fromUser User        @relation("SentInvites", fields: [fromUserId], references: [id])
  toUser   User        @relation("RecvInvites", fields: [toUserId], references: [id])

  @@unique([sessionId, toUserId])
  @@index([toUserId, status])
}

model PowerUpSpawn {
  id          String      @id @default(uuid())
  sessionId   String
  type        PowerUpType
  latitude    Float
  longitude   Float
  isCollected Boolean     @default(false)
  collectedBy String?
  spawnedAt   DateTime    @default(now())
  expiresAt   DateTime

  session GameSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, isCollected])
}

model GamePlayer {
  id           String     @id @default(uuid())
  sessionId    String
  userId       String
  role         PlayerRole
  squad        String?
  isCaught     Boolean    @default(false)
  caughtAt     DateTime?
  arrestCode   String
  batteryLevel Int        @default(100)
  inventory    Json       @default("[]")
  activeBuffs  Json       @default("{}")
  hearts       Int        @default(3)
  isJailed     Boolean    @default(false)
  isOut        Boolean    @default(false)
  outAt        DateTime?
  hiddenFromHistory Boolean @default(false)
  joinedAt     DateTime   @default(now())
  // When this player explicitly agreed to share their live location for this specific
  // match — the "check in" App Store guideline 5.1.2(i) requires before a user's location
  // is shown to others on a map, done once per match rather than per location update
  // (which isn't technically meaningful for a live radar). Null until they consent.
  locationSharingConsentedAt DateTime?

  session GameSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId, role])
}

model LocationLog {
  id        String   @id @default(uuid())
  sessionId String
  playerId  String
  latitude  Float
  longitude Float
  accuracy  Float
  speed     Float?
  timestamp DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, playerId, timestamp])
}

model GameEvent {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  payload   Json
  timestamp DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, type])
}
